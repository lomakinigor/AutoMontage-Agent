# Compatibility declarations for the explicit legacy provider scripts.
# Стандартный reel-turnkey оставляет их пустыми: локальный монтаж, lesson draft, preview,
# Review, approval, render и QA работают через подписку Claude Code/Codex без provider API.
# Заполняйте только при осознанном отдельном запуске provider API; значение не коммитьте.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Опционально: абсолютный путь к папке внешних тем вида <theme-id>/theme.json.
THEMES_EXT=

# Опционально: папка bin отдельной полной сборки ffmpeg/ffprobe.
# Нужна, например, когда системный ffmpeg не содержит libwebp для импорта фото в Review.
AUTOMONTAGE_FFMPEG_DIR=

# Internal test hooks: they are set by the test runner and require no user value.
AUTOMONTAGE_BUILD_CAPTURE=
AUTOMONTAGE_LESSON_CAPTURE=
AUTOMONTAGE_LESSON_FAIL_RENDER=

# Internal Review-to-preview snapshot guards; set by the local server, not by users.
AUTOMONTAGE_PREVIEW_MANIFEST_HASH=
AUTOMONTAGE_PREVIEW_BRIEF_HASH=

# Optional B-roll search provider. Core montage still works without API keys.
BROLL_SEARCH_PROVIDER=pexels
PEXELS_API_KEY=

# Reserved for optional future providers.
PIXABAY_API_KEY=
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
